#!/usr/bin/env bash

CODE_SERVER_DATAROOT="$HOME/.local/share/code-server"
mkdir -p "$CODE_SERVER_DATAROOT/extensions"

# Expose the password to the server.
export PASSWORD="$password"

#
# Start Code Server.
#
echo "$(date): Started code-server"

<%- if context.project_directory != "" %>
export VSCODE_PROJECT_DIR=<%= context.project_directory %>
<%- else %>
export VSCODE_PROJECT_DIR=${HOME}
<%- end %>

code-server \
    --auth="password" \
    --bind-addr="0.0.0.0:${port}" \
    --disable-telemetry \
    --ignore-last-opened \
    --user-data-dir="$CODE_SERVER_DATAROOT" \
    --log debug \
    ${VSCODE_PROJECT_DIR}
